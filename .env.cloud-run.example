# Google Cloud Run Environment Variables Example
# 
# This file shows the environment variables needed for deploying PaperDebugger to Cloud Run.
# DO NOT commit this file with real values! This is just a template.
#
# For Cloud Run deployment, you can set these using either:
# 1. Command line: --set-env-vars flag (see docs/CLOUD_RUN_DEPLOYMENT.md)
# 2. Secret Manager: --update-secrets flag (recommended for production)
# 3. Cloud Console: Cloud Run service configuration UI

# Required: OpenAI API Key for AI functionality
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: MongoDB connection URI
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/paperdebugger
# For self-hosted: mongodb://hostname:27017/paperdebugger
PD_MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/paperdebugger

# Required: JWT signing key (generate with: openssl rand -base64 32)
JWT_SIGNING_KEY=your-secure-random-jwt-signing-key-here

# Optional: Custom OpenAI API endpoint (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Custom inference endpoint
# INFERENCE_BASE_URL=https://inference.paperdebugger.workers.dev

# Optional: Inference API key (if using custom inference endpoint)
# INFERENCE_API_KEY=your-inference-api-key

# Optional: XtraMCP server URI (for advanced orchestration features)
# XTRAMCP_URI=http://xtramcp-server:8080/mcp

# Optional: MCP server URL (for Model Context Protocol)
# MCP_SERVER_URL=http://mcp-server:8000

# Note: PORT environment variable is automatically set by Cloud Run
# You don't need to set it manually. Default is 8080.
# PORT=8080

# =============================================================================
# Deployment Commands Examples:
# =============================================================================

# Simple deployment with environment variables:
# gcloud run deploy paperdebugger \
#   --source . \
#   --region us-central1 \
#   --allow-unauthenticated \
#   --set-env-vars "OPENAI_API_KEY=sk-..." \
#   --set-env-vars "PD_MONGO_URI=mongodb+srv://..." \
#   --set-env-vars "JWT_SIGNING_KEY=..."

# Deployment using Secret Manager (recommended):
# 1. Create secrets:
#    echo -n "sk-..." | gcloud secrets create openai-api-key --data-file=-
#    echo -n "mongodb+srv://..." | gcloud secrets create mongo-uri --data-file=-
#    openssl rand -base64 32 | gcloud secrets create jwt-signing-key --data-file=-
#
# 2. Deploy with secrets:
#    gcloud run deploy paperdebugger \
#      --source . \
#      --region us-central1 \
#      --allow-unauthenticated \
#      --update-secrets="OPENAI_API_KEY=openai-api-key:latest" \
#      --update-secrets="PD_MONGO_URI=mongo-uri:latest" \
#      --update-secrets="JWT_SIGNING_KEY=jwt-signing-key:latest"

# Use the automated script (easiest):
# ./scripts/deploy-cloud-run.sh
